package gauge

import (
	"strconv"
)

templ liquidExactValues(label string, minimum, maximum int, values []Data) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark" data-goshtoso-gauge-liquid-values>
		<summary class="cursor-pointer font-semibold">Exact bounded readings</summary>
		<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">{ label }. Range: { strconv.Itoa(minimum) } to { strconv.Itoa(maximum) }.</p>
		<div class="mt-2 max-h-80 overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left">
				<thead>
					<tr>
						<th class="px-3 py-2" scope="col">Reading</th>
						<th class="px-3 py-2" scope="col">Value</th>
					</tr>
				</thead>
				<tbody>
					for _, value := range values {
						<tr class="border-t border-outline dark:border-outline-dark">
							<th class="px-3 py-2 font-semibold" scope="row">{ value.Name }</th>
							<td class="px-3 py-2 tabular-nums">{ strconv.FormatFloat(value.Value, 'g', -1, 64) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}
