package interactive

import (
	"fmt"
	"strconv"
)

templ bar3DExactCells(axes Bar3DAxes, series []Bar3DSeries) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact 3D bar values</summary>
		<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">{ strconv.Itoa(bar3DCellCount(series)) } cells across { strconv.Itoa(len(series)) } series.</p>
		<div class="mt-2 max-h-80 overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left">
				<thead class="sticky top-0 bg-surface-alt dark:bg-surface-dark-alt">
					<tr>
						<th class="px-3 py-2" scope="col">Series</th>
						<th class="px-3 py-2" scope="col">{ axes.X.Name }</th>
						<th class="px-3 py-2" scope="col">{ axes.Y.Name }</th>
						<th class="px-3 py-2" scope="col">X index</th>
						<th class="px-3 py-2" scope="col">Y index</th>
						<th class="px-3 py-2" scope="col">Value</th>
						<th class="px-3 py-2" scope="col">Class</th>
					</tr>
				</thead>
				<tbody>
					for _, item := range series {
						for _, cell := range item.Cells {
							<tr class="border-t border-outline dark:border-outline-dark">
								<td class="px-3 py-2">{ item.Name }</td>
								<th class="px-3 py-2 font-semibold" scope="row">{ axes.X.Categories[cell.XIndex] }</th>
								<td class="px-3 py-2">{ axes.Y.Categories[cell.YIndex] }</td>
								<td class="px-3 py-2 tabular-nums">{ strconv.Itoa(cell.XIndex) }</td>
								<td class="px-3 py-2 tabular-nums">{ strconv.Itoa(cell.YIndex) }</td>
								<td class="px-3 py-2 tabular-nums">{ fmt.Sprintf("%g", cell.Value) }</td>
								<td class="px-3 py-2">{ cell.Class }</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</details>
}
