package interactive

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ interactiveTemplate(cfg renderConfig, element templ.Component, script templ.Component) {
	@charttheme.Styles()
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-interactive") } role="img" aria-label={ cfg.Label } data-goshtoso-charts-responsive-width={ cfg.ResponsiveWidth } data-goshtoso-charts-explicit-colors={ explicitColors(cfg.Style) } data-goshtoso-charts-explicit-visual-map-colors={ cfg.ExplicitVisualMapColors } data-goshtoso-charts-explicit-animation={ animationPreference(cfg.Animation) } data-goshtoso-charts-theme-series-items={ themeSeriesItems(cfg.ThemeSeriesItems) } data-goshtoso-charts-gauge-scale={ cfg.GaugeScale } data-goshtoso-charts-candlestick-styles={ cfg.CandlestickStyles } data-goshtoso-charts-liquid={ cfg.Liquid } data-goshtoso-charts-geo-geometry-paint={ cfg.GeoGeometryPaint } data-goshtoso-charts-geo-series-paints={ cfg.GeoSeriesPaints } data-goshtoso-charts-scatter3d-paints={ cfg.Scatter3DPaints } data-goshtoso-charts-scatter3d-cold-to-warm={ cfg.Scatter3DColdToWarm } data-goshtoso-charts-bar3d-paints={ cfg.Bar3DPaints } data-goshtoso-charts-bar3d-cold-to-warm={ cfg.Bar3DColdToWarm } data-goshtoso-charts-surface3d-paints={ cfg.Surface3DPaints } data-goshtoso-charts-surface3d-cold-to-warm={ cfg.Surface3DColdToWarm } data-goshtoso-charts-line3d-paints={ cfg.Line3DPaints } data-goshtoso-charts-line3d-cold-to-warm={ cfg.Line3DColdToWarm } data-goshtoso-charts-line3d-auto-rotate={ cfg.Line3DAutoRotate } data-goshtoso-charts-pie-auto-emphasis={ cfg.PieAutoEmphasis } { liveAttributes(cfg.Live)... } { cfg.RootAttrs... }>
		@element
		@script
		@themeRuntime()
		if cfg.Live != nil {
			@liveRuntime()
		}
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
	if cfg.Details != nil {
		@cfg.Details
	}
}
