package sunburst

templ sunburstExactValues(rows []valueRow) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact hierarchy and values</summary>
		<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left">
				<thead>
					<tr>
						<th class="px-3 py-2" scope="col">Path</th>
						<th class="px-3 py-2" scope="col">Parent</th>
						<th class="px-3 py-2" scope="col">Value</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr class="border-t border-outline dark:border-outline-dark">
							<th class="px-3 py-2 font-semibold" scope="row">{ row.Path }</th>
							<td class="px-3 py-2">{ row.Parent }</td>
							<td class="px-3 py-2 tabular-nums">{ row.Value }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}
