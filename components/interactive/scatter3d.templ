package interactive

import (
	"fmt"
	"strconv"
)

templ scatter3DExactPoints(series []Scatter3DSeries) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact 3D point values</summary>
		<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">{ strconv.Itoa(scatter3DPointCount(series)) } points across { strconv.Itoa(len(series)) } series.</p>
		<div class="mt-2 max-h-80 overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left">
				<thead class="sticky top-0 bg-surface-alt dark:bg-surface-dark-alt">
					<tr>
						<th class="px-3 py-2" scope="col">Series</th>
						<th class="px-3 py-2" scope="col">Point</th>
						<th class="px-3 py-2" scope="col">X</th>
						<th class="px-3 py-2" scope="col">Y</th>
						<th class="px-3 py-2" scope="col">Z</th>
						<th class="px-3 py-2" scope="col">Value</th>
						<th class="px-3 py-2" scope="col">Class</th>
					</tr>
				</thead>
				<tbody>
					for _, item := range series {
						for _, point := range item.Points {
							<tr class="border-t border-outline dark:border-outline-dark">
								<td class="px-3 py-2">{ item.Name }</td>
								<th class="px-3 py-2 font-semibold" scope="row">{ point.Name }</th>
								<td class="px-3 py-2 tabular-nums">{ fmt.Sprintf("%g", point.X) }</td>
								<td class="px-3 py-2 tabular-nums">{ fmt.Sprintf("%g", point.Y) }</td>
								<td class="px-3 py-2 tabular-nums">{ fmt.Sprintf("%g", point.Z) }</td>
								<td class="px-3 py-2 tabular-nums">{ scatter3DPointValue(point) }</td>
								<td class="px-3 py-2">{ point.Class }</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</details>
}
