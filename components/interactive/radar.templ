package interactive

templ radarExactValues(label string, indicators []RadarIndicator, rows []radarValueRow) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark" data-radar-exact-values>
		<summary class="cursor-pointer font-semibold">Exact radar values</summary>
		<div class="mt-2 max-h-80 overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-max border-collapse text-left" aria-label={ label + " exact radar values" }>
				<thead class="sticky top-0 bg-surface-alt dark:bg-surface-dark-alt">
					<tr>
						<th scope="col" class="px-3 py-2 font-semibold">Series</th>
						<th scope="col" class="px-3 py-2 font-semibold">Observation</th>
						for _, indicator := range indicators {
							<th scope="col" class="px-3 py-2 font-semibold">{ indicator.Name }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr data-radar-value-row class="border-t border-outline dark:border-outline-dark">
							<td class="px-3 py-2">{ row.Series }</td>
							<th scope="row" class="px-3 py-2 font-semibold">{ row.Observation }</th>
							for _, value := range row.Values {
								<td class="px-3 py-2 tabular-nums">{ value }</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}
