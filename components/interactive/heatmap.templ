package interactive

templ heatMapExactValues(label string, coordinate HeatMapCoordinate, rows []heatMapValueRow) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark" data-heatmap-exact-values>
		<summary class="cursor-pointer font-semibold">Exact heatmap values</summary>
		<div tabindex="0" role="region" aria-label={ label + " exact heatmap values" } class="mt-2 max-h-80 max-w-full overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left" aria-label={ label + " exact heatmap values" }>
				<thead class="sticky top-0 bg-surface-alt dark:bg-surface-dark-alt">
					<tr>
						<th scope="col" class="px-3 py-2 font-semibold">Series</th>
						if coordinate == HeatMapCoordinateCalendar {
							<th scope="col" class="px-3 py-2 font-semibold">Date</th>
						} else {
							<th scope="col" class="px-3 py-2 font-semibold">X category</th>
							<th scope="col" class="px-3 py-2 font-semibold">Y category</th>
						}
						<th scope="col" class="px-3 py-2 font-semibold">Value</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr data-heatmap-value-row data-heatmap-missing={ heatMapBoolString(row.Missing) } class="border-t border-outline dark:border-outline-dark">
							<td class="px-3 py-2">{ row.Series }</td>
							if coordinate == HeatMapCoordinateCalendar {
								<th scope="row" class="px-3 py-2 font-semibold">{ row.Date }</th>
							} else {
								<td class="px-3 py-2">{ row.X }</td>
								<th scope="row" class="px-3 py-2 font-semibold">{ row.Y }</th>
							}
							<td class="px-3 py-2 tabular-nums">{ row.Value }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}
