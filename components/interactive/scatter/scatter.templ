package scatter

import (
	"fmt"
	"strconv"
)

templ exactValuesTemplate(cfg Config, valueAxis bool) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark" data-scatter-exact-values>
		<summary class="cursor-pointer font-semibold">Exact scatter values</summary>
		<div class="mt-2 max-h-80 overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-max border-collapse text-left" aria-label={ cfg.Label + " exact scatter values" }>
				<thead>
					<tr>
						<th class="px-3 py-2" scope="col">Point</th>
						<th class="px-3 py-2" scope="col">Series</th>
						if valueAxis {
							<th class="px-3 py-2" scope="col">X</th>
							<th class="px-3 py-2" scope="col">Y</th>
						} else {
							<th class="px-3 py-2" scope="col">Value</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, series := range cfg.Series {
						for index, point := range series.Data {
							<tr class="border-t border-outline dark:border-outline-dark">
								if valueAxis {
									<th class="px-3 py-2 font-semibold" scope="row">{ pointName(point, strconv.Itoa(index+1)) }</th>
									<td class="px-3 py-2">{ series.Name }</td>
									<td class="px-3 py-2 tabular-nums">{ fmt.Sprintf("%g", point.X) }</td>
									<td class="px-3 py-2 tabular-nums">{ fmt.Sprintf("%g", point.Y) }</td>
								} else {
									<th class="px-3 py-2 font-semibold" scope="row">{ pointName(point, cfg.XAxis[index]) }</th>
									<td class="px-3 py-2">{ series.Name }</td>
									<td class="px-3 py-2 tabular-nums">{ fmt.Sprintf("%g", point.Value) }</td>
								}
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
		<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">{ strconv.Itoa(pointCount(cfg)) } points across { strconv.Itoa(len(cfg.Series)) } series.</p>
	</details>
}
