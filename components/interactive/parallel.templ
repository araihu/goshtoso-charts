package interactive

import "strconv"

templ parallelExactValues(dimensions []ParallelDimension, values parallelValueRows) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact observations and values</summary>
		<div class="mt-2 max-h-80 max-w-full overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-max border-collapse text-left">
				<thead>
					<tr>
						<th class="px-3 py-2" scope="col">Series</th>
						<th class="px-3 py-2" scope="col">Observation</th>
						for _, dimension := range dimensions {
							<th class="px-3 py-2" scope="col">{ dimension.Name }</th>
						}
						<th class="px-3 py-2" scope="col">Semantic class</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range values.Rows {
						<tr class="border-t border-outline dark:border-outline-dark">
							<th class="px-3 py-2 font-semibold" scope="row">{ row.Series }</th>
							<td class="px-3 py-2">{ row.Observation }</td>
							for _, value := range row.Values {
								<td class="px-3 py-2 tabular-nums">{ value }</td>
							}
							<td class="px-3 py-2">{ row.Class }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if values.Omitted > 0 {
			<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">
				{ strconv.Itoa(values.Omitted) } additional observations omitted from this bounded representation.
			</p>
		}
	</details>
}
