package candlestick

import "strconv"

templ candlestickExactValues(values candlestickValueRows) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact OHLC values</summary>
		<div class="mt-2 max-h-80 max-w-full overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-max border-collapse text-left">
				<thead>
					<tr>
						<th class="px-3 py-2" scope="col">Category</th>
						<th class="px-3 py-2" scope="col">Series</th>
						<th class="px-3 py-2" scope="col">Open</th>
						<th class="px-3 py-2" scope="col">Close</th>
						<th class="px-3 py-2" scope="col">Low</th>
						<th class="px-3 py-2" scope="col">High</th>
						<th class="px-3 py-2" scope="col">Direction</th>
						<th class="px-3 py-2" scope="col">Semantic class</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range values.Rows {
						<tr class="border-t border-outline dark:border-outline-dark">
							<th class="px-3 py-2 font-semibold" scope="row">{ row.Category }</th>
							<td class="px-3 py-2">{ row.Series }</td>
							<td class="px-3 py-2 tabular-nums">{ row.Open }</td>
							<td class="px-3 py-2 tabular-nums">{ row.Close }</td>
							<td class="px-3 py-2 tabular-nums">{ row.Low }</td>
							<td class="px-3 py-2 tabular-nums">{ row.High }</td>
							<td class={ "px-3 py-2 font-semibold", row.DirectionClass }>{ row.Direction }</td>
							<td class="px-3 py-2">{ row.SemanticClass }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if values.Omitted > 0 {
			<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">
				{ strconv.Itoa(values.Omitted) } additional OHLC observations omitted from this bounded representation.
			</p>
		}
	</details>
}
