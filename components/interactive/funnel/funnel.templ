package funnel

templ funnelExactValues(label string, rows []valueRow) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark" data-funnel-exact-values>
		<summary class="cursor-pointer font-semibold">Exact funnel values</summary>
		<div class="mt-2 max-h-80 max-w-full overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left" aria-label={ label + " exact funnel values" }>
				<thead class="sticky top-0 bg-surface-alt dark:bg-surface-dark-alt">
					<tr>
						<th scope="col" class="px-3 py-2 font-semibold">Series</th>
						<th scope="col" class="px-3 py-2 font-semibold">Stage</th>
						<th scope="col" class="px-3 py-2 font-semibold">Value</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr data-funnel-value-row class="border-t border-outline dark:border-outline-dark">
							<td class="px-3 py-2">{ row.Series }</td>
							<th scope="row" class="px-3 py-2 font-semibold">{ row.Stage }</th>
							<td class="px-3 py-2 tabular-nums">{ row.Value }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}
