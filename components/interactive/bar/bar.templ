package bar

import (
	"fmt"
	"strconv"
)

templ exactValues(cfg Config) {
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark" data-bar-exact-values>
		<summary class="cursor-pointer font-semibold">Exact category values</summary>
		<div class="mt-2 max-h-80 overflow-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-max border-collapse text-left" aria-label={ cfg.Label + " exact category values" }>
				<thead><tr><th class="px-3 py-2" scope="col">Category</th><th class="px-3 py-2" scope="col">Series</th><th class="px-3 py-2" scope="col">Value</th></tr></thead>
				<tbody>
					for index, category := range cfg.XAxis {
						for _, series := range cfg.Series {
							<tr class="border-t border-outline dark:border-outline-dark"><th class="px-3 py-2 font-semibold" scope="row">{ category }</th><td class="px-3 py-2">{ series.Name }</td><td class="px-3 py-2 tabular-nums">{ fmt.Sprintf("%g", series.Data[index].Value) }</td></tr>
						}
					}
				</tbody>
			</table>
		</div>
		<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">{ strconv.Itoa(len(cfg.XAxis)) } categories across { strconv.Itoa(len(cfg.Series)) } series.</p>
	</details>
}
