package pie

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ pieTemplate(cfg Config, chart templ.Component) {
	@charttheme.Styles()
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-pie") } role="img" aria-label={ cfg.Label }>
		@chart
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
}
