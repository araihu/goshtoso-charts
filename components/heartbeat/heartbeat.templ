package heartbeat

import "fmt"

templ heartbeatTemplate(cfg Config, points []renderPoint, summary string) {
	<figure class={ cfg.rootClasses() } role="img" aria-label={ cfg.Label } { cfg.RootAttrs... }>
		if len(points) == 0 {
			<div class="rounded-radius border border-dashed border-outline px-4 py-3 text-sm text-on-surface dark:border-outline-dark dark:text-on-surface-dark">No monitoring data in this period.</div>
		} else {
			<svg viewBox="0 0 600 24" preserveAspectRatio="none" class="h-6 w-full" aria-hidden="true" focusable="false">
				for _, point := range points {
					<g>
						<title>{ point.Title }</title>
						<rect x={ fmt.Sprint(point.X) } y="0" width={ fmt.Sprint(point.Width) } height="24" rx="2" fill={ point.Fill }></rect>
					</g>
				}
			</svg>
		}
		<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ summary }</figcaption>
	</figure>
}
