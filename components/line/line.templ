package line

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ lineTemplate(cfg Config, chart templ.Component) {
	@charttheme.Styles()
	<style>
		.goshtoso-charts-line__viewport > svg { display: block; width: 100%; height: auto; max-width: 100%; }
		.goshtoso-charts-expanded .goshtoso-charts-line {
			display: flex;
			width: 100%;
			height: 100%;
			min-height: 0;
			flex-direction: column;
			justify-content: center;
		}
		.goshtoso-charts-expanded .goshtoso-charts-line__viewport {
			display: flex;
			width: 100%;
			height: 100%;
			min-height: 0;
			flex: 1 1 auto;
			align-items: center;
			justify-content: center;
			overflow: hidden;
		}
		.goshtoso-charts-expanded .goshtoso-charts-line__viewport > svg {
			width: 100%;
			height: 100%;
			min-width: 0;
			max-height: 100%;
		}
	</style>
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-line") } role="img" aria-label={ cfg.Label }>
		<div class="goshtoso-charts-line__viewport mx-auto max-w-full overflow-x-auto">@chart</div>
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact series values</summary>
		<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left" aria-label={ cfg.Label + " exact series values and Y axis mapping" }>
				<thead><tr><th class="px-3 py-2" scope="col">Label</th><th class="px-3 py-2" scope="col">Series</th><th class="px-3 py-2" scope="col">Y axis</th><th class="px-3 py-2" scope="col">Value</th></tr></thead>
				<tbody>
					for labelIndex, label := range cfg.Labels {
						for _, series := range cfg.Series {
							<tr class={ "border-t border-outline dark:border-outline-dark " + series.Class }>
								<th class="px-3 py-2 font-semibold" scope="row">{ label }</th>
								<td class="px-3 py-2">{ series.Name }</td>
								<td class={ "px-3 py-2 " + axisClass(cfg, series.YAxisIndex) }>{ axisName(cfg, series.YAxisIndex) }</td>
								<td class="px-3 py-2 tabular-nums">{ formatSeriesValue(series, labelIndex) }</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
		if cfg.hasReferences() {
			<h3 class="mt-4 font-semibold">Reference evidence</h3>
			<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
				<table class="min-w-full border-collapse text-left" aria-label={ cfg.Label + " statistical reference evidence" }>
					<thead><tr><th class="px-3 py-2" scope="col">Series</th><th class="px-3 py-2" scope="col">Reference</th><th class="px-3 py-2" scope="col">Value</th><th class="px-3 py-2" scope="col">Label</th></tr></thead>
					<tbody>
						for _, series := range cfg.Series {
							if series.References.Average || series.References.Minimum || series.References.Maximum {
								{{ summary := summarizeLineReferences(series) }}
								if series.References.Average {
									<tr class={ "border-t border-outline dark:border-outline-dark " + series.References.Style.Class }><th class="px-3 py-2 font-semibold" scope="row">{ series.Name }</th><td class="px-3 py-2">Average</td><td class="px-3 py-2 tabular-nums">{ formatReferenceValue(summary.Average, series.References) }</td><td class="px-3 py-2">All available points</td></tr>
								}
								if series.References.Maximum {
									<tr class={ "border-t border-outline dark:border-outline-dark " + series.References.Style.Class }><th class="px-3 py-2 font-semibold" scope="row">{ series.Name }</th><td class="px-3 py-2">Maximum</td><td class="px-3 py-2 tabular-nums">{ formatReferenceValue(summary.Maximum, series.References) }</td><td class="px-3 py-2">{ cfg.Labels[summary.MaximumIndex] }</td></tr>
								}
								if series.References.Minimum {
									<tr class={ "border-t border-outline dark:border-outline-dark " + series.References.Style.Class }><th class="px-3 py-2 font-semibold" scope="row">{ series.Name }</th><td class="px-3 py-2">Minimum</td><td class="px-3 py-2 tabular-nums">{ formatReferenceValue(summary.Minimum, series.References) }</td><td class="px-3 py-2">{ cfg.Labels[summary.MinimumIndex] }</td></tr>
								}
							}
						}
					</tbody>
				</table>
			</div>
		}
	</details>
}
