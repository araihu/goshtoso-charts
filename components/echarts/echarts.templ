package echarts

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ echartTemplate(cfg Config, element templ.Component, script templ.Component) {
	@charttheme.Styles()
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-echarts") } role="img" aria-label={ cfg.Label }>
		@element
		@script
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
}
