package candlestick

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ candlestickTemplate(cfg Config, chart templ.Component) {
	@charttheme.Styles()
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-candlestick") } role="img" aria-label={ cfg.Label } { cfg.RootAttrs... }>
		<div class="goshtoso-charts-candlestick__viewport max-w-full overflow-x-auto">@chart</div>
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact OHLC values</summary>
		<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">Increase means close is greater than or equal to open; decrease means close is below open. Detected patterns are named in text and do not depend on color.</p>
		<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left" aria-label={ cfg.SeriesName + " exact OHLC values" }>
				<thead><tr>
					<th class="px-3 py-2" scope="col">Period</th><th class="px-3 py-2" scope="col">Direction</th>
					<th class="px-3 py-2" scope="col">Open</th><th class="px-3 py-2" scope="col">High</th>
					<th class="px-3 py-2" scope="col">Low</th><th class="px-3 py-2" scope="col">Close</th>
					if cfg.Patterns.Selection != "" {
						<th class="px-3 py-2" scope="col">Detected patterns</th>
					}
					for _, trend := range cfg.TrendLines {
						<th class="px-3 py-2" scope="col">{ trendLabel(trend.Type) }</th>
					}
				</tr></thead>
				<tbody>
					for index, datum := range cfg.Data {
						<tr class="border-t border-outline dark:border-outline-dark">
							<th class="px-3 py-2 font-semibold" scope="row">{ datum.Label }</th>
							<td class="px-3 py-2 font-semibold"><span class={ rowDirectionClass(cfg, datum) } aria-hidden="true">●</span> { direction(datum) }</td>
							<td class="px-3 py-2 tabular-nums">{ formatValue(datum.Open) }</td><td class="px-3 py-2 tabular-nums">{ formatValue(datum.High) }</td>
							<td class="px-3 py-2 tabular-nums">{ formatValue(datum.Low) }</td><td class="px-3 py-2 tabular-nums">{ formatValue(datum.Close) }</td>
							if cfg.Patterns.Selection != "" {
								<td class="px-3 py-2">{ patternNamesAt(cfg, index) }</td>
							}
							for _, trend := range computedTrendValues(cfg)[index] {
								<td class="px-3 py-2 tabular-nums">{ formatTrendValue(trend.Value) }</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}
