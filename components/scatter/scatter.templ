package scatter

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ scatterTemplate(cfg Config, chart templ.Component) {
	@charttheme.Styles()
	<style>
		.goshtoso-charts-scatter__viewport > svg { display: block; width: 100%; height: auto; min-width: 0; max-width: 100%; }
		.goshtoso-charts-expanded .goshtoso-charts-scatter {
			display: flex;
			width: 100%;
			height: 100%;
			min-height: 0;
			flex-direction: column;
			justify-content: center;
		}
		.goshtoso-charts-expanded .goshtoso-charts-scatter__viewport {
			display: flex;
			width: 100%;
			height: 100%;
			min-height: 0;
			flex: 1 1 auto;
			align-items: center;
			justify-content: center;
			overflow: hidden;
		}
		.goshtoso-charts-expanded .goshtoso-charts-scatter__viewport > svg {
			width: 100%;
			height: 100%;
			min-width: 0;
			max-height: 100%;
		}
	</style>
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-scatter") } role="img" aria-label={ cfg.Label } { cfg.RootAttrs... }>
		<div class="goshtoso-charts-scatter__viewport mx-auto max-w-full overflow-x-auto">
			@chart
		</div>
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
	if rows := cfg.topNLabelRows(); len(rows) > 0 {
		<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
			<summary class="cursor-pointer font-semibold">Exact values and selected labels</summary>
			<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
				<table class="min-w-full border-collapse text-left" aria-label={ cfg.Label + " exact values and selected top labels" }>
					<thead><tr><th class="px-3 py-2" scope="col">Category</th><th class="px-3 py-2" scope="col">Series</th><th class="px-3 py-2" scope="col">Value</th><th class="px-3 py-2" scope="col">Selected label</th></tr></thead>
					<tbody>
						for _, row := range rows {
							<tr class={ "border-t border-outline dark:border-outline-dark " + row.Class }>
								<th class="px-3 py-2 font-semibold" scope="row">{ row.Category }</th>
								<td class="px-3 py-2">{ row.Series }</td>
								<td class="px-3 py-2 tabular-nums">{ formatValue(row.Value) }</td>
								if row.Selected {
									<td class="px-3 py-2">Yes</td>
								} else {
									<td class="px-3 py-2">No</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</details>
	}
}
