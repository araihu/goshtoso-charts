package heatmap

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ heatMapTemplate(cfg Config, chart templ.Component) {
	@charttheme.Styles()
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-heatmap") } role="img" aria-label={ cfg.Label } data-heatmap-reverse={ formatBool(cfg.Gradient.Reverse) } { cfg.RootAttrs... }>
		<div class="goshtoso-charts-heatmap__viewport mx-auto overflow-x-auto">
			@chart
		</div>
		<div class="goshtoso-charts-heatmap__scale mt-3" aria-label={ "Value scale from " + formatValue(cfg.ValueRange.Min) + " to " + formatValue(cfg.ValueRange.Max) }>
			<div class="goshtoso-charts-heatmap__scale-gradient h-3 rounded-full border border-outline dark:border-outline-dark" style={ map[string]templ.SafeCSSProperty{"background": cfg.scaleBackground()} }></div>
			<div class="mt-1 flex justify-between text-xs tabular-nums text-on-surface-muted dark:text-on-surface-dark-muted">
				<span>{ formatValue(cfg.ValueRange.Min) } · { scaleLowLabel(cfg.Gradient) }</span>
				<span>{ formatValue(cfg.ValueRange.Max) } · { scaleHighLabel(cfg.Gradient) }</span>
			</div>
		</div>
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact values</summary>
		<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left">
				<thead><tr><th class="px-3 py-2" scope="col">Y</th><th class="px-3 py-2" scope="col">X</th><th class="px-3 py-2" scope="col">Value</th></tr></thead>
				<tbody>
					for index, cell := range cfg.exactCells() {
						if index < exactValueLimit {
							<tr class="border-t border-outline dark:border-outline-dark">
								<th class="px-3 py-2 font-semibold" scope="row">{ cfg.YAxis.Labels[cell.Y] }</th>
								<td class="px-3 py-2">{ cfg.XAxis.Labels[cell.X] }</td>
								<td class="px-3 py-2 tabular-nums">{ formatValue(cell.Value) }</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
		if len(cfg.exactCells()) > exactValueLimit {
			<p class="mt-2 text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Showing first { formatInt(exactValueLimit) } of { formatInt(len(cfg.exactCells())) } cells.</p>
		}
	</details>
}
