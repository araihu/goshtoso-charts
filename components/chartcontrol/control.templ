package chartcontrol

import (
	"github.com/araihu/goshtoso/components/actiongroup"
	"github.com/araihu/goshtoso/components/modal"
	"github.com/araihu/goshtoso-charts/assets"
)

templ wrapperTemplate(cfg WrapperConfig, formats []ExportFormat, chart templ.Component) {
	@Styles()
	<div
		class="goshtoso-charts-control-wrapper"
		data-goshtoso-chart-wrapper
		data-goshtoso-chart-capability={ string(cfg.Capability) }
		data-goshtoso-chart-export-filename={ exportFilename(cfg) }
		data-goshtoso-chart-export-background={ exportBackground(cfg) }
		data-goshtoso-chart-export-pixel-ratio={ exportPixelRatio(cfg) }
	>
		if cfg.Controls.Fullscreen || expandEnabled(cfg.Controls) || len(formats) > 0 {
			@actiongroup.ActionGroup(chartActions(cfg, formats))
		}
		if expandEnabled(cfg.Controls) {
			<div class="goshtoso-charts-expand-control goshtoso-charts-hidden-expand-modal" data-goshtoso-chart-expand>
				@modal.Modal(modal.Config{
					ID: expandID(cfg),
					Title: cfg.Label,
					TriggerLabel: "Expand",
					PrimaryLabel: "Close",
					PanelClass: "goshtoso-charts-expand-panel relative z-[2147483001]",
				})
			</div>
		}
		<div class="goshtoso-charts-control-content" data-goshtoso-chart-content>
			@chart
		</div>
		if len(formats) > 0 {
			<span class="sr-only" aria-live="polite" data-goshtoso-chart-export-status></span>
		}
		if hasRuntime(cfg, formats) {
			<script src={ templ.SafeURL(assets.ControlRuntimeURL) } defer></script>
		}
	</div>
}

templ fullscreenIcon() {
	<svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
		<path d="M7 3H3v4M13 3h4v4M7 17H3v-4M13 17h4v-4"></path>
	</svg>
}

templ expandIcon() {
	<svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
		<path d="M7 4H4v3M13 4h3v3M7 16H4v-3M13 16h3v-3"></path>
		<path d="M4 7l4-4M16 7l-4-4M4 13l4 4M16 13l-4 4"></path>
	</svg>
}

templ downloadIcon() {
	<svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
		<path d="M10 3v9m0 0 3-3m-3 3L7 9M4 16h12"></path>
	</svg>
}
