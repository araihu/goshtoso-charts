package chartcontrol

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/modal"
	"github.com/araihu/goshtoso/components/splitbutton"
	"github.com/araihu/goshtoso-charts/assets"
	"github.com/araihu/goshtoso-charts/assets/charticons"
)

templ wrapperTemplate(cfg WrapperConfig, formats []ExportFormat, chart templ.Component) {
	@Styles()
	<div
		class="goshtoso-charts-control-wrapper"
		data-goshtoso-chart-wrapper
		data-goshtoso-chart-wrapper-mode={ wrapperMode(cfg.Controls) }
		data-goshtoso-chart-capability={ string(cfg.Capability) }
		data-goshtoso-chart-export-filename={ exportFilename(cfg) }
		data-goshtoso-chart-export-background={ exportBackground(cfg) }
		data-goshtoso-chart-export-pixel-ratio={ exportPixelRatio(cfg) }
		if wrapperHidden(cfg.Controls) {
			hidden
			inert
			aria-hidden="true"
		}
	>
		if cfg.Controls.Fullscreen || expandEnabled(cfg.Controls) || len(formats) > 0 {
			<fieldset
				class="m-0 min-w-0 border-0 p-0"
				data-goshtoso-chart-actions-fieldset
				if wrapperDisabled(cfg.Controls) {
					disabled
					aria-disabled="true"
				}
			>
				@chartActionControls(cfg, formats)
			</fieldset>
		}
		if expandEnabled(cfg.Controls) {
			<div class="goshtoso-charts-expand-control goshtoso-charts-hidden-expand-modal" data-goshtoso-chart-expand>
				@modal.Modal(modal.Config{
					ID: expandID(cfg),
					Title: cfg.Label,
					TriggerLabel: "Expand",
					PrimaryLabel: "",
					PanelClass: "goshtoso-charts-expand-panel relative z-[2147483001]",
				})
			</div>
		}
		<div class="goshtoso-charts-control-content" data-goshtoso-chart-content>
			@chart
		</div>
		if len(formats) > 0 {
			<span class="sr-only" aria-live="polite" data-goshtoso-chart-export-status></span>
		}
		<script src={ templ.SafeURL(assets.ControlRuntimeURL) } defer></script>
	</div>
}

templ chartActionControls(cfg WrapperConfig, formats []ExportFormat) {
	<div
		class="goshtoso-charts-controls goshtoso-charts-controls-neutral mb-2"
		data-goshtoso-chart-actions
		data-goshtoso-chart-control-tone="neutral"
		role="group"
		aria-label={ cfg.Label + " chart controls" }
	>
		if expandEnabled(cfg.Controls) {
			if cfg.Controls.Fullscreen {
				@splitbutton.SplitButton(expandSplitButton(cfg))
			} else {
				@expandControl(cfg)
			}
		} else if cfg.Controls.Fullscreen {
			@fullscreenControl(cfg)
		}
		if cfg.Controls.Fullscreen {
			@collapseControl(cfg)
		}
		if len(formats) > 0 {
			@splitbutton.SplitButton(exportSplitButton(cfg, formats))
		}
	</div>
}

templ expandControl(cfg WrapperConfig) {
	@button.Button(
		button.WithID(expandID(cfg) + "-primary-action"),
		button.WithTone(button.ToneAlternate),
		button.WithSize(button.SizeMedium),
		button.WithRootClass("goshtoso-charts-control-button"),
		button.WithAttrs(templ.Attributes{
			"aria-label":  "Expand " + cfg.Label,
			"x-on:click": `window.__goshtosoChartsControls.expandFromMenu($el)`,
		}),
	) {
		@expandIcon()
		<span>Expand</span>
	}
}

templ fullscreenControl(cfg WrapperConfig) {
	@button.Button(
		button.WithID(fullscreenID(cfg)),
		button.WithTone(button.ToneAlternate),
		button.WithSize(button.SizeMedium),
		button.WithRootClass("goshtoso-charts-control-button"),
		button.WithAttrs(templ.Attributes{
			"aria-label":  "Enter fullscreen for " + cfg.Label,
			"aria-pressed": "false",
			"x-on:click":  `window.__goshtosoChartsControls.toggleFullscreen($el)`,
		}),
	) {
		@fullscreenIcon()
		<span>Fullscreen</span>
	}
}

templ collapseControl(cfg WrapperConfig) {
	@button.Button(
		button.WithID(expandID(cfg) + "-collapse-action"),
		button.WithTone(button.ToneAlternate),
		button.WithSize(button.SizeMedium),
		button.WithRootClass("goshtoso-charts-control-button"),
		button.WithAttrs(templ.Attributes{
			"aria-label":                 "Collapse " + cfg.Label,
			"data-goshtoso-chart-control": "collapse",
			"x-on:click":                 `window.__goshtosoChartsControls.collapseFullscreen($el)`,
			"hidden":                     true,
		}),
	) {
		@collapseIcon()
		<span>Collapse</span>
	}
}

templ fullscreenIcon() {
	@charticons.Icon(charticons.Config{
		Symbol:     charticons.IconHeroiconsOptimized24OutlineArrowsPointingOut,
		Size:       icon.SizeSM,
		Decorative: true,
		RootClass:  "shrink-0",
	})
}

templ expandIcon() {
	@charticons.Icon(charticons.Config{
		Symbol:     charticons.IconHeroiconsOptimized24OutlineArrowsPointingOut,
		Size:       icon.SizeSM,
		Decorative: true,
		RootClass:  "shrink-0",
	})
}

templ collapseIcon() {
	@charticons.Icon(charticons.Config{
		Symbol:     charticons.IconHeroiconsOptimized24OutlineArrowsPointingIn,
		Size:       icon.SizeSM,
		Decorative: true,
		RootClass:  "shrink-0",
	})
}

templ downloadIcon() {
	@charticons.Icon(charticons.Config{
		Symbol:     charticons.IconHeroiconsOptimized24OutlineArrowDownTray,
		Size:       icon.SizeSM,
		Decorative: true,
		RootClass:  "shrink-0",
	})
}

templ copyIcon() {
	@charticons.Icon(charticons.Config{
		Symbol:     charticons.IconHeroiconsOptimized24OutlineDocumentDuplicate,
		Size:       icon.SizeSM,
		Decorative: true,
		RootClass:  "shrink-0",
	})
}
