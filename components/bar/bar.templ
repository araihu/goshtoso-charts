package bar

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ barTemplate(cfg Config, chart templ.Component) {
	@charttheme.Styles()
	if cfg.horizontal() {
		<style>
			.goshtoso-charts-bar__viewport > svg { display: block; width: 100%; height: auto; max-width: 100%; }
			.goshtoso-charts-expanded .goshtoso-charts-bar__viewport,
			.goshtoso-charts-control-wrapper:fullscreen .goshtoso-charts-bar__viewport,
			.goshtoso-charts-control-wrapper.goshtoso-charts-fullscreen-fallback .goshtoso-charts-bar__viewport { width: 100%; height: 100%; overflow: hidden; }
			.goshtoso-charts-expanded .goshtoso-charts-bar__viewport > svg,
			.goshtoso-charts-control-wrapper:fullscreen .goshtoso-charts-bar__viewport > svg,
			.goshtoso-charts-control-wrapper.goshtoso-charts-fullscreen-fallback .goshtoso-charts-bar__viewport > svg { width: 100%; height: 100%; min-width: 0; }
		</style>
	}
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-bar") } role="img" aria-label={ cfg.Label }>
		if cfg.horizontal() {
			<div class="goshtoso-charts-bar__viewport mx-auto max-w-full overflow-x-auto">@chart</div>
		} else {
			@chart
		}
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
	if cfg.horizontal() {
		<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
			<summary class="cursor-pointer font-semibold">Exact category values</summary>
			<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
				<table class="min-w-full border-collapse text-left" aria-label={ cfg.Label + " exact category values" }>
					<thead><tr>
						<th class="px-3 py-2" scope="col">Category</th>
						for _, series := range cfg.Series {
							<th class="px-3 py-2" scope="col">{ series.Name }</th>
						}
					</tr></thead>
					<tbody>
						for categoryIndex, label := range cfg.Labels {
							<tr class="border-t border-outline dark:border-outline-dark">
								<th class="px-3 py-2 font-semibold" scope="row">{ label }</th>
								for _, series := range cfg.Series {
									<td class="px-3 py-2 tabular-nums">{ formatValue(series.Values[categoryIndex]) }</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</details>
	}
	if cfg.hasReferences() {
		<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark" open>
			<summary class="cursor-pointer font-semibold">Exact values and reference annotations</summary>
			<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
				<table class="min-w-full border-collapse text-left" aria-label={ cfg.Label + " exact values and reference annotations" }>
					<thead><tr><th class="px-3 py-2" scope="col">Category</th>
						for _, series := range cfg.Series {
							<th class="px-3 py-2" scope="col">{ series.Name }</th>
						}
					</tr></thead>
					<tbody>
						for categoryIndex, label := range cfg.Labels {
							<tr class="border-t border-outline dark:border-outline-dark"><th class="px-3 py-2 font-semibold" scope="row">{ label }</th>
								for _, series := range cfg.Series {
									<td class="px-3 py-2 tabular-nums">{ formatReferenceValue(series.Values[categoryIndex], series.References.Format) }</td>
								}
							</tr>
						}
					</tbody>
				</table>
				if cfg.hasSummaryReferences() {
					<table class="min-w-full border-collapse text-left" aria-label={ cfg.Label + " computed reference annotations" }>
						<thead><tr><th class="px-3 py-2" scope="col">Series</th><th class="px-3 py-2" scope="col">Average</th><th class="px-3 py-2" scope="col">Maximum</th><th class="px-3 py-2" scope="col">Minimum</th></tr></thead>
						<tbody>
							for _, series := range cfg.Series {
								if series.References.Average || series.References.Maximum || series.References.Minimum {
									{{ summary := summarizeReferences(series.Values) }}
									<tr class={ "border-t border-outline dark:border-outline-dark " + series.References.Style.Class }><th class="px-3 py-2 font-semibold" scope="row">{ series.Name }</th>
										<td class="px-3 py-2 tabular-nums">{ formatReferenceValue(summary.Average, series.References.Format) }</td>
										<td class="px-3 py-2 tabular-nums">{ formatReferenceValue(summary.Maximum, series.References.Format) + " at " + cfg.Labels[summary.MaximumIndex] }</td>
										<td class="px-3 py-2 tabular-nums">{ formatReferenceValue(summary.Minimum, series.References.Format) + " at " + cfg.Labels[summary.MinimumIndex] }</td>
									</tr>
								}
							}
						</tbody>
					</table>
				}
				if cfg.hasMaximumLine() {
					<table class="min-w-full border-collapse text-left" aria-label={ cfg.Label + " maximum-line annotations" }>
						<tbody>
							for _, series := range cfg.Series {
								if series.References.MaximumLine {
									{{ summary := summarizeReferences(series.Values) }}
									<tr class={ "border-t border-outline dark:border-outline-dark " + series.References.Style.Class }>
										<th class="px-3 py-2 font-semibold" scope="row">{ series.Name + " maximum line" }</th>
										<td class="px-3 py-2 tabular-nums">{ formatReferenceValue(summary.Maximum, series.References.Format) + " at " + cfg.Labels[summary.MaximumIndex] }</td>
									</tr>
								}
							}
						</tbody>
					</table>
				}
				if cfg.hasGlobalMaximum() {
					{{ maximum := cfg.summarizeStackedGlobalMaximum() }}
					<table class="min-w-full border-collapse text-left" aria-label={ cfg.Label + " stacked reference annotations" }>
						<tbody><tr class={ "border-t border-outline dark:border-outline-dark " + maximum.Class }>
							<th class="px-3 py-2 font-semibold" scope="row">Maximum stack total</th>
							<td class="px-3 py-2 tabular-nums">{ formatReferenceValue(maximum.Value, maximum.Format) + " at " + cfg.Labels[maximum.Index] }</td>
						</tr></tbody>
					</table>
				}
			</div>
		</details>
	}
}
