package radar

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ radarTemplate(cfg Config, chart templ.Component) {
	@charttheme.Styles()
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-radar") } role="img" aria-label={ cfg.Label } { cfg.RootAttrs... }>
		<div class="goshtoso-charts-radar__viewport mx-auto overflow-x-auto">
			@chart
		</div>
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact values</summary>
		<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left">
				<thead>
					<tr>
						<th class="px-3 py-2" scope="col">Series</th>
						for _, indicator := range cfg.Indicators {
							<th class="px-3 py-2" scope="col">
								{ indicator.Name }
								<span class="font-normal text-on-surface-muted dark:text-on-surface-dark-muted">
									if indicator.Min != 0 {
										(min { formatValue(indicator.Min) }, max { formatValue(indicator.Max) })
									} else {
										(max { formatValue(indicator.Max) })
									}
								</span>
							</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, series := range cfg.Series {
						<tr class="border-t border-outline dark:border-outline-dark">
							<th class="px-3 py-2 font-semibold" scope="row">{ series.Name }</th>
							for _, value := range series.Values {
								<td class="px-3 py-2 tabular-nums">{ formatValue(value) }</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}
