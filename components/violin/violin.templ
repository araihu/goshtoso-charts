package violin

import "github.com/araihu/goshtoso-charts/components/charttheme"

templ violinTemplate(cfg Config, chart templ.Component) {
	@charttheme.Styles()
	<style>
		.goshtoso-charts-violin__viewport svg { display: block; width: 100%; height: auto; max-width: 100%; }
		.goshtoso-charts-expanded .goshtoso-charts-violin__viewport,
		.goshtoso-charts-control-wrapper:fullscreen .goshtoso-charts-violin__viewport,
		.goshtoso-charts-control-wrapper.goshtoso-charts-fullscreen-fallback .goshtoso-charts-violin__viewport {
			width: 100%; height: 100%; overflow: hidden;
		}
		.goshtoso-charts-expanded .goshtoso-charts-violin__viewport svg,
		.goshtoso-charts-control-wrapper:fullscreen .goshtoso-charts-violin__viewport svg,
		.goshtoso-charts-control-wrapper.goshtoso-charts-fullscreen-fallback .goshtoso-charts-violin__viewport svg {
			width: 100%; height: 100%;
		}
	</style>
	<figure class={ cfg.Style.RootClasses("goshtoso-charts-violin") } role="img" aria-label={ cfg.Label } { cfg.RootAttrs... }>
		<div class="goshtoso-charts-violin__viewport mx-auto max-w-full overflow-x-auto">@chart</div>
		if cfg.Caption != "" {
			<figcaption class="mt-2 text-sm text-on-surface dark:text-on-surface-dark">{ cfg.Caption }</figcaption>
		}
	</figure>
	<details class="mt-3 max-w-full text-sm text-on-surface dark:text-on-surface-dark">
		<summary class="cursor-pointer font-semibold">Exact sample statistics</summary>
		<div class="mt-2 overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="min-w-full border-collapse text-left" aria-label={ cfg.Label + " exact sample statistics" }>
				<thead><tr><th class="px-3 py-2" scope="col">Distribution</th><th class="px-3 py-2" scope="col">Samples</th><th class="px-3 py-2" scope="col">Minimum</th><th class="px-3 py-2" scope="col">Q1</th><th class="px-3 py-2" scope="col">Median</th><th class="px-3 py-2" scope="col">Mean</th><th class="px-3 py-2" scope="col">Q3</th><th class="px-3 py-2" scope="col">Maximum</th></tr></thead>
				<tbody>
					for _, series := range cfg.Series {
						{{ stats := summarize(series.Samples) }}
						<tr class={ "border-t border-outline dark:border-outline-dark " + series.Class }>
							<th class="px-3 py-2 font-semibold" scope="row">{ series.Name }</th><td class="px-3 py-2 tabular-nums">{ formatInt(stats.Count) }</td>
							<td class="px-3 py-2 tabular-nums">{ formatValue(stats.Minimum) }</td><td class="px-3 py-2 tabular-nums">{ formatValue(stats.Q1) }</td><td class="px-3 py-2 tabular-nums">{ formatValue(stats.Median) }</td><td class="px-3 py-2 tabular-nums">{ formatValue(stats.Mean) }</td><td class="px-3 py-2 tabular-nums">{ formatValue(stats.Q3) }</td><td class="px-3 py-2 tabular-nums">{ formatValue(stats.Maximum) }</td>
						</tr>
						if len(requestedQuantiles(series)) > 0 {
							<tr class="border-t border-outline dark:border-outline-dark"><td class="px-3 py-2 text-on-surface-muted dark:text-on-surface-dark-muted" colspan="8">Additional quantiles for { series.Name }:
								for _, at := range requestedQuantiles(series) {
									<span class="ml-2 tabular-nums">{ formatQuantile(at) } = { formatValue(quantile(sortedSamples(series.Samples), at)) }</span>
								}
							</td></tr>
						}
					}
				</tbody>
			</table>
		</div>
	</details>
}
