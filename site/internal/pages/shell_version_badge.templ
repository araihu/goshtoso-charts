package pages

import (
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/link"
)

templ shellVersionBadge(version string) {
	if version == "development" {
		<span data-site-version="development" aria-label="Development build">
			@badge.Badge(badge.Config{Label: "dev", Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
		</span>
	} else if isReleasedSiteVersion(version) {
		@link.Link(
			"https://github.com/araihu/goshtoso-charts/releases/tag/"+version,
			link.WithTarget("_blank"),
			link.WithRootClass("no-underline hover:no-underline"),
			link.WithAttrs(templ.Attributes{
				"aria-label": "Goshtoso Charts release " + version,
				"data-site-version": version,
			}),
		) {
			@badge.Badge(badge.Config{Label: version, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
		}
	}
}
