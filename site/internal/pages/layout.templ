package pages

import "github.com/araihu/goshtoso/components/head"

type Page interface {
	templ.Component
}

templ layout(title string, active string, content templ.Component) {
	<!doctype html>
	<html lang="en" x-data="{ theme: 'goshtoso', dark: false }" x-init="$watch('theme', value => document.documentElement.setAttribute('data-theme', value)); document.documentElement.setAttribute('data-theme', theme)">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Goshtoso Charts</title>
			<meta name="description" content="Server-rendered chart components for Goshtoso applications."/>
			@head.Dependencies()
			<link rel="stylesheet" href="/site.css"/>
		</head>
		<body class="bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark" x-bind:class="dark ? 'dark' : ''">
			<a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-radius focus:bg-primary focus:px-3 focus:py-2 focus:text-on-primary" href="#main-content">Skip to content</a>
			<header class="sticky top-0 z-20 border-b border-outline bg-surface/95 backdrop-blur dark:border-outline-dark dark:bg-surface-dark/95">
				<div class="flex min-h-16 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
					<a class="flex min-w-0 items-center gap-3 font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong" href="/">
						<span class="charts-mark" aria-hidden="true">G</span>
						<span class="truncate">Goshtoso Charts</span>
					</a>
					<div class="flex items-center gap-2">
						<label class="sr-only" for="theme-select">Theme</label>
						<select id="theme-select" class="rounded-radius border border-control-outline bg-surface px-2 py-1 text-sm dark:border-control-outline-dark dark:bg-surface-dark" x-model="theme">
							<option value="goshtoso">Goshtoso</option>
							<option value="minimal">Minimal</option>
						</select>
						<button class="rounded-radius border border-control-outline px-3 py-1 text-sm font-medium dark:border-control-outline-dark" type="button" x-on:click="dark = !dark" x-text="dark ? 'Light mode' : 'Dark mode'"></button>
					</div>
				</div>
			</header>
			<div class="charts-shell px-4 py-6 sm:px-6 lg:px-8">
				<aside class="charts-sidebar" aria-label="Component navigation" x-data="{ query: '' }">
					<label class="sr-only" for="catalog-search">Search components</label>
					<div class="charts-search">
						<span aria-hidden="true">⌕</span>
						<input id="catalog-search" type="search" placeholder="Search catalog" autocomplete="off" x-model="query" x-on:keydown.escape="query = ''"/>
					</div>
					<nav class="charts-nav" aria-label="Catalog navigation">
						@navGroup("Start", queryExpression("overview")) {
							@navItem("/", "Overview", active == "overview", "overview")
						}
						@navGroup("Components", queryExpression("heartbeat line chart")) {
							@navItem("/components/heartbeat", "Heartbeat", active == "heartbeat", "heartbeat")
							@navItem("/components/line", "Line chart", active == "line", "line chart")
						}
						@navGroup("Examples", queryExpression("status page xisnove")) {
							@navItem("/examples/status-page", "Status page", active == "status-page", "status page xisnove")
						}
						<p class="charts-no-results" x-cloak x-show="query && !['overview', 'heartbeat', 'line chart', 'status page xisnove'].some(item => item.includes(query.toLowerCase()))">No catalog entries match.</p>
					</nav>
				</aside>
				<main id="main-content" tabindex="-1" class="charts-main min-w-0 space-y-8">
					@content
				</main>
			</div>
		</body>
	</html>
}

templ navGroup(label string, show string) {
	<section class="charts-nav-group" x-show={ show }>
		<h2>{ label }</h2>
		<div>{ children... }</div>
	</section>
}

templ navItem(href string, label string, active bool, searchTerms string) {
	<a href={ templ.SafeURL(href) } class={ navItemClass(active) } aria-current={ navCurrent(active) } x-show={ queryExpression(searchTerms) }>{ label }</a>
}
