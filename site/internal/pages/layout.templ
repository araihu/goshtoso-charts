package pages

import "github.com/araihu/goshtoso-app-shells/catalogshell"

type Page interface {
	templ.Component
}

templ layout(title string, active string, content templ.Component) {
	@catalogshell.Layout(shellConfig(), catalogshell.Page{
		Title: title,
		Description: "Server-rendered chart components for Goshtoso applications.",
		Active: active,
		Content: content,
		EnableTOC: active == "heartbeat" || active == "line",
	})
}
