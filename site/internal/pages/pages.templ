	@componentpage.Page(componentpage.Config{
		Title: "Interactive tree",
		Description: "Reusable hierarchy for parent-child relationships, layered or radial arrangement, and progressive disclosure under one renderer-neutral contract.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Explore ownership, taxonomy, ancestry, or other recursive parent-child structures.", "Primitive", "interactive.Tree", "Kind", "components.KindInteractiveTree", "Configuration", "Label, Caption, typed recursive Roots, layout, orientation, initial depth, collapsed nodes, labels, roam, symbols, insets, size, chart options, and chart style.", "Accessibility", "Figure name comes from Label and Caption stays visible. Preserve every node name, value, and parent-child path in adjacent text or a table when exact data matters."),
			Preview: sampleInteractiveTree(),
			Code: interactiveTreeCode(),
		},
		After: demoNote("Hierarchy contract", "Layered is the zero-value layout; radial remains a variant of the same Tree component. InitialDepth and per-node Collapsed state control initial disclosure. Keep an adjacent nested list or table as the exact-data source."),
	})
}

templ interactiveChartFunnelContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Interactive funnel",
		Description: "Reusable interactive funnel component for comparing named stage volumes with typed ordering under one stable component contract.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Show progressive reduction or conversion across a small sequence of named stages.", "Primitive", "interactive.Funnel", "Kind", "components.KindInteractiveFunnel", "Configuration", "Label, Caption, descending, ascending, or caller-data Order, typed Series and stages, size, renderer-neutral ChartOptions and SeriesOptions, and chart style.", "Accessibility", "Figure name comes from Label and Caption stays visible. Preserve stage names, values, and intended order in adjacent content."),
			Preview: interactive.Funnel(sampleInteractiveFunnel()),
			Code: interactiveChartFunnelCode(),
		},
		After: demoNote("Ordering contract", "FunnelOrderDescending is the zero-value default. Ascending and caller-data ordering remain variants of the same constructor, config, Instance, and stable Kind."),
	})
}

templ pieContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Pie chart",
		Description: "Categorical SSR SVG for compact part-to-whole summaries. Use it when the category count stays small and a total supports comparison.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Summarize a small categorical status distribution as parts of a total.", "Primitive", "pie.Pie", "Kind", "components.KindPieChart", "Configuration", "Label, Caption, named Slices, optional Width, and Height.", "Accessibility", "Figure name comes from Label; Caption stays visible. Keep an adjacent table or text summary when exact values are needed."),
			Preview: pie.Pie(sampleObservationStates()),
			Code: pieCode(),
		},
		After: demoNote("Use case", "Use pie charts for bounded status breakdowns, not ordered time-series data. Aggregate domain data at the application view-model boundary."),
	})
}

templ scatterContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Scatter chart",
		Description: "Categorical SSR SVG for showing repeated observations, clusters, and outliers across an explicit ordered set of keys.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Compare distributions of observations across ordered categories without browser rendering.", "Primitive", "scatter.Scatter", "Kind", "components.KindScatterChart", "Configuration", "Label, Caption, ordered Categories, named Series with categorical Points, typed marker Symbol and Size options, Width, Height, root class and attributes, and chart palette.", "Accessibility", "Figure name comes from Label; Caption stays visible. Keep exact points in an adjacent table or text summary when values matter."),
			Preview: scatter.Scatter(sampleDenseScatter()),
			Code: scatterCode(),
		},
		After: demoNote("Category contract", "Categories define equally spaced keys in caller order. Numeric-looking category labels remain categories, not proportional numeric X coordinates. Symbol and Size are presentation options on this same component."),
	})
}

templ lineContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Line chart",
		Description: "Quantitative SSR SVG for latency, queue depth, or any ordered numeric series. Renderer stays Go-native; surrounding panel stays application-owned.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Summarize one or more ordered numeric series without browser rendering.", "Primitive", "line.Line", "Kind", "components.KindLineChart", "Configuration", "Label, Caption, axis Labels, named Series, optional Width, and Height.", "Accessibility", "Figure name comes from Label; Caption stays visible. Keep an adjacent table or text summary when exact values are needed."),
			Preview: line.Line(sampleLatency()),
			Code: lineCode(),
		},
		After: demoNote("Theme contract", "Static line charts resolve Goshtoso semantic CSS tokens at display time. One SSR response follows every built-in theme and its dark mode; no browser chart renderer is involved."),
	})
}

templ LiveAvailabilityExample(fragment bool) {
	@layout("Live availability", "live-availability", liveAvailabilityContent(), fragment)
}

templ liveAvailabilityContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Live availability",
		Description: "An application example built from the generic interactive Bar component and renderer-neutral server-sent event snapshots.",
		Primary: componentpage.Example{
			AbovePreview: demoNote("Live-data contract", "Bar and Line accept an opt-in LiveData source. Each SSE event carries a complete CartesianSnapshot, so reconnects replace stale client state deterministically."),
			Preview: interactive.Bar(sampleLiveAvailability()),
			Code: liveAvailabilityCode(),
		},
		After: demoNote("Application semantics", "Availability states belong to this example, not the chart taxonomy. Narrow stacked bars express checks while text and legend preserve state meaning without relying on color alone."),
	})
}

templ demoNote(title string, text string) {
	<section class="rounded-radius border border-outline bg-surface-alt p-5 dark:border-outline-dark dark:bg-surface-dark-alt"><h2 id={ tocID(title) } data-toc-heading class="text-base font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ text }</p></section>
}

templ componentContract(purposeLabel string, purpose string, primitiveLabel string, primitive string, kindLabel string, kind string, configLabel string, config string, accessibilityLabel string, accessibility string) {
	<section class="rounded-radius border border-outline bg-surface-alt p-5 dark:border-outline-dark dark:bg-surface-dark-alt" aria-label="Component contract">
		<dl class="grid gap-4 lg:grid-cols-2">
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ purposeLabel }</dt><dd class="mt-1 text-sm text-on-surface dark:text-on-surface-dark">{ purpose }</dd></div>
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ primitiveLabel }</dt><dd class="mt-1 break-words font-mono text-sm text-on-surface dark:text-on-surface-dark">{ primitive }</dd></div>
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ kindLabel }</dt><dd class="mt-1 break-words font-mono text-sm text-on-surface dark:text-on-surface-dark">{ kind }</dd></div>
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ configLabel }</dt><dd class="mt-1 text-sm text-on-surface dark:text-on-surface-dark">{ config }</dd></div>
			<div class="lg:col-span-2"><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ accessibilityLabel }</dt><dd class="mt-1 text-sm text-on-surface dark:text-on-surface-dark">{ accessibility }</dd></div>
		</dl>
	</section>
}
