package pages

import (
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/panel"
	"github.com/araihu/goshtoso-app-shells/componentpage"
	"github.com/araihu/goshtoso-charts/components/bar"
	interactive "github.com/araihu/goshtoso-charts/components/echarts"
	"github.com/araihu/goshtoso-charts/components/heartbeat"
	"github.com/araihu/goshtoso-charts/components/line"
	"github.com/araihu/goshtoso-charts/components/pie"
	"github.com/araihu/goshtoso-charts/site/internal/brand"
	"github.com/araihu/goshtoso-charts/site/internal/echartsexamples"
)

templ OverviewPage(fragment bool) {
	@layout("Overview", "overview", overviewContent(), fragment)
}

templ overviewContent() {
	<section class="max-w-3xl space-y-4">
		<div class="flex flex-wrap items-end gap-x-3 gap-y-1" aria-label="Goshtoso Charts">
			@brand.LandingLogo()
			<p class="pb-1 text-sm font-semibold uppercase tracking-wide text-primary dark:text-primary-dark">Charts</p>
		</div>
		<h1 class="font-title text-4xl font-bold tracking-tight text-on-surface-strong dark:text-on-surface-dark-strong">SSR charts for Goshtoso</h1>
		<p class="max-w-2xl text-lg text-on-surface-muted dark:text-on-surface-dark-muted">Generic Go and templ chart components. First driver: Xisnove monitor detail and public status pages. No browser renderer, hydration, or chart-runtime assets.</p>
	</section>
	<div class="grid gap-4 md:grid-cols-2">
		@panel.Panel(panel.Config{Header: overviewHeartbeatHeader()}) {
			@heartbeat.Heartbeat(sampleHeartbeat())
		}
		@panel.Panel(panel.Config{Header: overviewLineHeader()}) {
			@line.Line(sampleLatency())
		}
		@panel.Panel(panel.Config{Header: overviewBarHeader()}) {
			@bar.Bar(sampleDeployments())
		}
		@panel.Panel(panel.Config{Header: overviewPieHeader()}) {
			@pie.Pie(sampleObservationStates())
		}
	</div>
	@demoNote("Component contract", "Each component has typed Config, concrete Instance, stable Kind, and templ.Component rendering. Consumers choose page composition; charts supply evidence surfaces.")
}

templ HeartbeatPage(fragment bool) {
	@layout("Heartbeat", "heartbeat", heartbeatContent(), fragment)
}

templ heartbeatContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Heartbeat",
		Description: "Compact availability history. Use it for monitor health and status-page evidence; retain exact values in nearby copy or a detail table.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Compact ordered availability evidence for a monitor or public-status row.", "Primitive", "heartbeat.Heartbeat", "Kind", "components.KindHeartbeat", "Configuration", "Label, Caption, chronological Points, RootClass, and RootAttrs.", "Accessibility", "Figure name comes from Label; Caption remains visible; every point exposes timestamp, state, and optional latency in its SVG title. Empty points render an explicit no-data state."),
			Preview: heartbeat.Heartbeat(sampleHeartbeat()),
			Code: heartbeatCode(),
		},
		Sections: []componentpage.Example{{
			Title: "No data",
			Description: "Absence of probes is not uptime.",
			Preview: heartbeat.Heartbeat(heartbeat.Config{Label: "API availability"}),
			Code: noDataCode(),
		}},
		After: demoNote("State contract", "up, degraded, down, and unknown are distinct. Color supports scanning; figure label, SVG titles, and text summary supply meaning."),
	})
}

templ LinePage(fragment bool) {
	@layout("Line chart", "line", lineContent(), fragment)
}

templ BarPage(fragment bool) {
	@layout("Bar chart", "bar", barContent(), fragment)
}

templ barContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Bar chart",
		Description: "Categorical SSR SVG for counts, comparisons, and grouped operational outcomes. Set Stacked for composition within each category.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Compare named values across categories, including stacked operational outcomes.", "Primitive", "bar.Bar", "Kind", "components.KindBarChart", "Configuration", "Label, Caption, category Labels, named Series, Stacked, optional Width, and Height.", "Accessibility", "Figure name comes from Label; Caption stays visible. Keep an adjacent table or text summary when exact values are needed."),
			Preview: bar.Bar(sampleDeployments()),
			Code: barCode(),
		},
		After: demoNote("Use case", "Use bar charts for deployment outcomes, observation counts, or other categorical comparisons. Keep domain aggregation at the application view-model boundary."),
	})
}

templ PiePage(fragment bool) {
	@layout("Pie chart", "pie", pieContent(), fragment)
}

templ pieContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Pie chart",
		Description: "Categorical SSR SVG for compact part-to-whole summaries. Use it when the category count stays small and a total supports comparison.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Summarize a small categorical status distribution as parts of a total.", "Primitive", "pie.Pie", "Kind", "components.KindPieChart", "Configuration", "Label, Caption, named Slices, optional Width, and Height.", "Accessibility", "Figure name comes from Label; Caption stays visible. Keep an adjacent table or text summary when exact values are needed."),
			Preview: pie.Pie(sampleObservationStates()),
			Code: pieCode(),
		},
		After: demoNote("Use case", "Use pie charts for bounded status breakdowns, not ordered time-series data. Aggregate domain data at the application view-model boundary."),
	})
}

templ lineContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Line chart",
		Description: "Quantitative SSR SVG for latency, queue depth, or any ordered numeric series. Renderer stays Go-native; surrounding panel stays application-owned.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Summarize one or more ordered numeric series without browser rendering.", "Primitive", "line.Line", "Kind", "components.KindLineChart", "Configuration", "Label, Caption, axis Labels, named Series, optional Width, and Height.", "Accessibility", "Figure name comes from Label; Caption stays visible. Keep an adjacent table or text summary when exact values are needed."),
			Preview: line.Line(sampleLatency()),
			Code: lineCode(),
		},
		After: demoNote("Theme contract", "Line and heartbeat resolve Goshtoso semantic CSS tokens at display time. One SSR response follows every built-in theme and its dark mode; no browser chart renderer is involved."),
	})
}

templ StatusPageExample(fragment bool) {
	@layout("Status page example", "status-page", statusPageContent(), fragment)
}

templ EChartsCatalogPage(examples []echartsexamples.Example, fragment bool) {
	@layout("go-echarts catalog", "go-echarts", eChartsCatalogContent(examples), fragment)
}

templ eChartsCatalogContent(examples []echartsexamples.Example) {
	<section class="space-y-2">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">Interactive examples</p>
		<h1 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">go-echarts catalog</h1>
		<p class="max-w-3xl text-on-surface-muted dark:text-on-surface-dark-muted">Direct ports of upstream examples. Interactive charts use pinned local ECharts assets; SSR primitives remain available separately.</p>
	</section>
	<section class="grid gap-3 md:grid-cols-2" aria-label="go-echarts examples">
		for _, example := range examples {
			<a class="rounded-radius border border-outline bg-surface p-4 no-underline hover:bg-surface-alt dark:border-outline-dark dark:bg-surface-dark dark:hover:bg-surface-dark-alt" href={ "/examples/go-echarts/" + example.Slug }>
				<p class="text-xs font-semibold uppercase tracking-wide text-primary dark:text-primary-dark">{ example.Group }</p>
				<h2 class="mt-1 text-base font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ example.Title }</h2>
				<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ example.Source }</p>
			</a>
		}
	</section>
}

templ EChartsExamplePage(example echartsexamples.Example, fragment bool) {
	@layout(example.Title, "go-echarts", eChartsExampleContent(example), fragment)
}

templ eChartsExampleContent(example echartsexamples.Example) {
	<section class="space-y-2">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">{ example.Group }</p>
		<h1 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ example.Title }</h1>
		<a class="text-sm text-primary underline dark:text-primary-dark" href={ example.Source }>Upstream source</a>
	</section>
	@panel.Panel(panel.Config{Body: interactive.EChart(interactive.Config{Label: example.Title, Caption: "Interactive go-echarts port using a pinned local runtime.", Chart: example.Build()})})
	<p><a class="text-sm text-primary underline dark:text-primary-dark" href="/examples/go-echarts">All go-echarts examples</a></p>
}

templ statusPageContent() {
	<section class="space-y-2">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">Examples / Xisnove</p>
		<h1 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Status page example</h1>
		<p class="max-w-3xl text-on-surface-muted dark:text-on-surface-dark-muted">Chart package stays generic. Xisnove maps its monitor and retained-observation projections at view-model boundary.</p>
	</section>
	<section class="space-y-4" aria-label="Example monitor status">
		@statusMonitor("Public API", badge.ToneSuccess, "Operational", heartbeat.Heartbeat(sampleHeartbeat()))
		@statusMonitor("DNS resolution", badge.ToneWarning, "Degraded", heartbeat.Heartbeat(sampleDegradedHeartbeat()))
		@statusMonitor("Webhook delivery", badge.ToneDanger, "Incident open", heartbeat.Heartbeat(sampleFailedHeartbeat()))
	</section>
}

templ statusMonitor(name string, tone badge.Tone, state string, chart templ.Component) {
	@panel.Panel(panel.Config{Header: statusHeader(name, tone, state)}) {
		@chart
	}
}

templ statusHeader(name string, tone badge.Tone, state string) {
	<div class="flex flex-wrap items-center gap-2">
		<h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ name }</h2>
		@badge.Badge(badge.Config{Label: state, Tone: tone})
	</div>
}

templ overviewHeartbeatHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Availability</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Heartbeat primitive</p></div>
}

templ overviewLineHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Latency</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Line primitive</p></div>
}

templ overviewBarHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Deployments</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Bar primitive</p></div>
}

templ overviewPieHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Observation states</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Pie primitive</p></div>
}

templ demoNote(title string, text string) {
	<section class="rounded-radius border border-outline bg-surface-alt p-5 dark:border-outline-dark dark:bg-surface-dark-alt"><h2 id={ tocID(title) } data-toc-heading class="text-base font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ text }</p></section>
}

templ componentContract(purposeLabel string, purpose string, primitiveLabel string, primitive string, kindLabel string, kind string, configLabel string, config string, accessibilityLabel string, accessibility string) {
	<section class="rounded-radius border border-outline bg-surface-alt p-5 dark:border-outline-dark dark:bg-surface-dark-alt" aria-label="Component contract">
		<dl class="grid gap-4 lg:grid-cols-2">
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ purposeLabel }</dt><dd class="mt-1 text-sm text-on-surface dark:text-on-surface-dark">{ purpose }</dd></div>
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ primitiveLabel }</dt><dd class="mt-1 break-words font-mono text-sm text-on-surface dark:text-on-surface-dark">{ primitive }</dd></div>
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ kindLabel }</dt><dd class="mt-1 break-words font-mono text-sm text-on-surface dark:text-on-surface-dark">{ kind }</dd></div>
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ configLabel }</dt><dd class="mt-1 text-sm text-on-surface dark:text-on-surface-dark">{ config }</dd></div>
			<div class="lg:col-span-2"><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ accessibilityLabel }</dt><dd class="mt-1 text-sm text-on-surface dark:text-on-surface-dark">{ accessibility }</dd></div>
		</dl>
	</section>
}
