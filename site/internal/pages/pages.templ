templ pieContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Pie chart",
		Description: "Categorical SSR SVG for compact part-to-whole summaries. Use it when the category count stays small and a total supports comparison.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Summarize a small categorical status distribution as parts of a total.", "Primitive", "pie.Pie", "Kind", "components.KindPieChart", "Configuration", "Label, Caption, named Slices, optional Width, and Height.", "Accessibility", "Figure name comes from Label; Caption stays visible. Keep an adjacent table or text summary when exact values are needed."),
			Preview: pie.Pie(sampleObservationStates()),
			Code: pieCode(),
		},
		After: demoNote("Use case", "Use pie charts for bounded status breakdowns, not ordered time-series data. Aggregate domain data at the application view-model boundary."),
	})
}

templ lineContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Line chart",
		Description: "Quantitative SSR SVG for latency, queue depth, or any ordered numeric series. Renderer stays Go-native; surrounding panel stays application-owned.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Summarize one or more ordered numeric series without browser rendering.", "Primitive", "line.Line", "Kind", "components.KindLineChart", "Configuration", "Label, Caption, axis Labels, named Series, optional Width, and Height.", "Accessibility", "Figure name comes from Label; Caption stays visible. Keep an adjacent table or text summary when exact values are needed."),
			Preview: line.Line(sampleLatency()),
			Code: lineCode(),
		},
		After: demoNote("Theme contract", "Line and heartbeat resolve Goshtoso semantic CSS tokens at display time. One SSR response follows every built-in theme and its dark mode; no browser chart renderer is involved."),
	})
}

templ StatusPageExample(fragment bool) {
	@layout("Status page example", "status-page", statusPageContent(), fragment)
}

templ statusPageContent() {
	<section class="space-y-2">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">Examples / Xisnove</p>
		<h1 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Status page example</h1>
		<p class="max-w-3xl text-on-surface-muted dark:text-on-surface-dark-muted">Chart package stays generic. Xisnove maps its monitor and retained-observation projections at view-model boundary.</p>
	</section>
	<section class="space-y-4" aria-label="Example monitor status">
		@statusMonitor("Public API", badge.ToneSuccess, "Operational", heartbeat.Heartbeat(sampleHeartbeat()))
		@statusMonitor("DNS resolution", badge.ToneWarning, "Degraded", heartbeat.Heartbeat(sampleDegradedHeartbeat()))
		@statusMonitor("Webhook delivery", badge.ToneDanger, "Incident open", heartbeat.Heartbeat(sampleFailedHeartbeat()))
	</section>
}

templ statusMonitor(name string, tone badge.Tone, state string, chart templ.Component) {
	@panel.Panel(panel.Config{Header: statusHeader(name, tone, state)}) {
		@chart
	}
}

templ statusHeader(name string, tone badge.Tone, state string) {
	<div class="flex flex-wrap items-center gap-2">
		<h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ name }</h2>
		@badge.Badge(badge.Config{Label: state, Tone: tone})
	</div>
}

templ overviewHeartbeatHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Availability</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Heartbeat primitive</p></div>
}

templ overviewLineHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Latency</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Line primitive</p></div>
}

templ overviewBarHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Deployments</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Bar primitive</p></div>
}

templ overviewPieHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Observation states</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Pie primitive</p></div>
}

templ demoNote(title string, text string) {
	<section class="rounded-radius border border-outline bg-surface-alt p-5 dark:border-outline-dark dark:bg-surface-dark-alt"><h2 id={ tocID(title) } data-toc-heading class="text-base font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ text }</p></section>
}

templ componentContract(purposeLabel string, purpose string, primitiveLabel string, primitive string, kindLabel string, kind string, configLabel string, config string, accessibilityLabel string, accessibility string) {
	<section class="rounded-radius border border-outline bg-surface-alt p-5 dark:border-outline-dark dark:bg-surface-dark-alt" aria-label="Component contract">
		<dl class="grid gap-4 lg:grid-cols-2">
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ purposeLabel }</dt><dd class="mt-1 text-sm text-on-surface dark:text-on-surface-dark">{ purpose }</dd></div>
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ primitiveLabel }</dt><dd class="mt-1 break-words font-mono text-sm text-on-surface dark:text-on-surface-dark">{ primitive }</dd></div>
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ kindLabel }</dt><dd class="mt-1 break-words font-mono text-sm text-on-surface dark:text-on-surface-dark">{ kind }</dd></div>
			<div><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ configLabel }</dt><dd class="mt-1 text-sm text-on-surface dark:text-on-surface-dark">{ config }</dd></div>
			<div class="lg:col-span-2"><dt class="text-xs font-bold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ accessibilityLabel }</dt><dd class="mt-1 text-sm text-on-surface dark:text-on-surface-dark">{ accessibility }</dd></div>
		</dl>
	</section>
}
