templ GettingStartedPage(fragment bool) {
	@layout("Getting Started", "getting-started", gettingStartedContent(), fragment)
}

templ gettingStartedContent() {
	<div class="max-w-3xl space-y-12">
	<section class="space-y-4">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">Goshtoso Charts</p>
		<h1 class="font-title text-4xl font-bold tracking-tight text-on-surface-strong dark:text-on-surface-dark-strong">Getting Started</h1>
		<p class="text-lg text-on-surface-muted dark:text-on-surface-dark-muted">Install the module, wire the local chart runtime once, then render typed static or interactive charts with renderer-neutral APIs.</p>
	</section>
	<section class="space-y-4" data-getting-started-step>
		<h2 id="install-the-module" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">1. Install the module</h2>
		<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Add Goshtoso Charts to an existing Go and templ application.</p>
		@codeblock.CodeBlock(gettingStartedCodeBlock("bash", "bash", gettingStartedInstallCode))
	</section>
	<section class="space-y-4" data-getting-started-step>
		<h2 id="mount-chart-assets" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">2. Mount chart assets</h2>
		<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Interactive charts use a versioned runtime embedded in the module. Mount its handler at the exported prefix; the handler removes that prefix itself.</p>
		@codeblock.CodeBlock(gettingStartedCodeBlock("go", "Go", gettingStartedAssetsCode))
	</section>
	<section class="space-y-4" data-getting-started-step>
		<h2 id="include-chart-dependencies" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">3. Include chart dependencies</h2>
		<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Render the dependency component once in the document head, before interactive chart initialization. Local vendored delivery is the default.</p>
		@codeblock.CodeBlock(gettingStartedCodeBlock("templ", "templ", gettingStartedDependenciesCode))
		<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Third-party delivery is explicit: use <code class="font-mono">dependencies.WithCDN()</code> only when the application accepts that network and CSP boundary.</p>
	</section>
	<section class="space-y-4" data-getting-started-step>
		<h2 id="render-a-static-chart" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">4. Render a static chart</h2>
		<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Static/vector components render on the server and need no browser chart runtime.</p>
		@codeblock.CodeBlock(gettingStartedCodeBlock("templ", "templ", gettingStartedStaticCode))
	</section>
	<section class="space-y-4" data-getting-started-step>
		<h2 id="render-an-interactive-chart" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">5. Render an interactive chart</h2>
		<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Interactive components use the same typed component contract while keeping browser-renderer details private.</p>
		@codeblock.CodeBlock(gettingStartedCodeBlock("templ", "templ", gettingStartedInteractiveCode))
	</section>
	<section class="space-y-4" data-getting-started-step>
		<h2 id="explore-the-catalog" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">6. Explore the catalog</h2>
		<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Browse categorized <a class="font-semibold text-primary underline dark:text-primary-dark" href="/components/line">static/vector</a>, <a class="font-semibold text-primary underline dark:text-primary-dark" href="/components/interactive/bar">interactive Cartesian</a>, and <a class="font-semibold text-primary underline dark:text-primary-dark" href="/components/interactive/graph">relationship</a> components. The <a class="font-semibold text-primary underline dark:text-primary-dark" href="/examples/live-availability">Live availability</a> example demonstrates renderer-neutral full-snapshot SSE updates.</p>
	</section>
	</div>
}

templ LinePage(fragment bool) {
	@layout("Line chart", "line", lineContent(), fragment)
}

templ BarPage(fragment bool) {
	@layout("Bar chart", "bar", barContent(), fragment)
}

templ barContent() {
	@componentpage.Page(componentpage.Config{
		Title: "Bar chart",
		Description: "Categorical SSR SVG for vertical or horizontal comparisons. Set Stacked for composition within each category.",
		Primary: componentpage.Example{
			AbovePreview: componentContract("Purpose", "Compare named values across categories, including stacked outcomes, horizontal treatments, and per-series statistical references.", "Primitive", "bar.Bar", "Kind", "components.KindBarChart", "Configuration", "Label, Caption, Title, category Labels, named Series, Stacked, typed Orientation and Padding, References with average/minimum/maximum, value format and safe style controls, optional Width, and Height.", "Accessibility", "Figure name comes from Label and Caption stays visible. Horizontal charts include exact category values; reference variants include all values and computed average/minimum/maximum evidence."),
			Preview: bar.Bar(sampleDeployments()),
			Code: barCode(),
		},
		Sections: []componentpage.Example{
			{
				Title: "Horizontal orientation",
				Description: "Use the typed horizontal variant when category labels read more naturally beside bars. Vertical remains the zero-value default.",
				Preview: bar.Bar(sampleHorizontalWorldPopulation()),
				Code: horizontalBarCode(),
			},
			{
				Title: "Statistical reference annotations",
				Description: "Average lines and minimum/maximum points stay typed per series. Exact values and computed references remain adjacent to chart without relying on color.",
				Preview: bar.Bar(sampleBarReferences()),
				Code: barReferencesCode(),
			},
		},
		After: demoNote("Behavior variants", "Vertical is the zero-value default. Horizontal changes axis treatment on this Bar component; typed references add average lines and minimum/maximum points with adjacent exact evidence."),
	})
}

