package pages

import (
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/panel"
	"github.com/araihu/goshtoso-charts/components/heartbeat"
	"github.com/araihu/goshtoso-charts/components/line"
)

templ OverviewPage() {
	@layout("Overview", "overview", overviewContent())
}

templ overviewContent() {
	<section class="max-w-3xl space-y-4">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">Goshtoso Charts</p>
		<h1 class="font-title text-4xl font-bold tracking-tight text-on-surface-strong dark:text-on-surface-dark-strong">SSR charts for Goshtoso</h1>
		<p class="max-w-2xl text-lg text-on-surface-muted dark:text-on-surface-dark-muted">Generic Go and templ chart components. First driver: Xisnove monitor detail and public status pages. No browser renderer, hydration, or chart-runtime assets.</p>
	</section>
	<div class="grid gap-4 md:grid-cols-2">
		@panel.Panel(panel.Config{Header: overviewHeartbeatHeader()}) {
			@heartbeat.Heartbeat(sampleHeartbeat())
		}
		@panel.Panel(panel.Config{Header: overviewLineHeader()}) {
			@line.Line(sampleLatency())
		}
	</div>
	@demoNote("Component contract", "Each component has typed Config, concrete Instance, stable Kind, and templ.Component rendering. Consumers choose page composition; charts supply evidence surfaces.")
}

templ HeartbeatPage() {
	@layout("Heartbeat", "heartbeat", heartbeatContent())
}

templ heartbeatContent() {
	<section class="space-y-2">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">Components / Heartbeat</p>
		<h1 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Heartbeat</h1>
		<p class="max-w-3xl text-on-surface-muted dark:text-on-surface-dark-muted">Compact availability history. Use it for monitor health and status-page evidence; retain exact values in nearby copy or a detail table.</p>
	</section>
	@demoPanel("Monitor availability", "Mixed states and latency titles", heartbeat.Heartbeat(sampleHeartbeat()), heartbeatCode())
	@demoPanel("No data", "Absence of probes is not uptime", heartbeat.Heartbeat(heartbeat.Config{Label: "API availability"}), noDataCode())
	@demoNote("State contract", "up, degraded, down, and unknown are distinct. Color supports scanning; figure label, SVG titles, and text summary supply meaning.")
}

templ LinePage() {
	@layout("Line chart", "line", lineContent())
}

templ lineContent() {
	<section class="space-y-2">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">Components / Line chart</p>
		<h1 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Line chart</h1>
		<p class="max-w-3xl text-on-surface-muted dark:text-on-surface-dark-muted">Quantitative SSR SVG for latency, queue depth, or any ordered numeric series. Renderer stays Go-native; surrounding panel stays application-owned.</p>
	</section>
	@demoPanel("HTTPS monitor latency", "Seven observations in milliseconds", line.Line(sampleLatency()), lineCode())
	@demoNote("Theme contract", "Line and heartbeat resolve Goshtoso semantic CSS tokens at display time. One SSR response follows every built-in theme and its dark mode; no browser chart renderer is involved.")
}

templ StatusPageExample() {
	@layout("Status page example", "status-page", statusPageContent())
}

templ statusPageContent() {
	<section class="space-y-2">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">Examples / Xisnove</p>
		<h1 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Status page example</h1>
		<p class="max-w-3xl text-on-surface-muted dark:text-on-surface-dark-muted">Chart package stays generic. Xisnove maps its monitor and retained-observation projections at view-model boundary.</p>
	</section>
	<section class="space-y-4" aria-label="Example monitor status">
		@statusMonitor("Public API", badge.ToneSuccess, "Operational", heartbeat.Heartbeat(sampleHeartbeat()))
		@statusMonitor("DNS resolution", badge.ToneWarning, "Degraded", heartbeat.Heartbeat(sampleDegradedHeartbeat()))
		@statusMonitor("Webhook delivery", badge.ToneDanger, "Incident open", heartbeat.Heartbeat(sampleFailedHeartbeat()))
	</section>
}

templ statusMonitor(name string, tone badge.Tone, state string, chart templ.Component) {
	@panel.Panel(panel.Config{Header: statusHeader(name, tone, state)}) {
		@chart
	}
}

templ statusHeader(name string, tone badge.Tone, state string) {
	<div class="flex flex-wrap items-center gap-2">
		<h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ name }</h2>
		@badge.Badge(badge.Config{Label: state, Tone: tone})
	</div>
}

templ overviewHeartbeatHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Availability</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Heartbeat primitive</p></div>
}

templ overviewLineHeader() {
	<div><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Latency</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Line primitive</p></div>
}

templ demoPanel(title string, description string, preview templ.Component, code string) {
	<section class="overflow-hidden rounded-radius border border-outline dark:border-outline-dark">
		<div class="border-b border-outline bg-surface-alt px-5 py-4 dark:border-outline-dark dark:bg-surface-dark-alt"><h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ description }</p></div>
		<div class="p-5">@preview</div>
		<pre class="overflow-x-auto border-t border-outline bg-surface-alt p-5 text-xs text-on-surface dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark"><code>{ code }</code></pre>
	</section>
}

templ demoNote(title string, text string) {
	<section class="rounded-radius border border-outline bg-surface-alt p-5 dark:border-outline-dark dark:bg-surface-dark-alt"><h2 class="text-base font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h2><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ text }</p></section>
}
