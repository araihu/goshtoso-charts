package pages

// sidebarGettingStartedIcon mirrors Goshtoso's native top-level getting-started icon.
templ sidebarGettingStartedIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-full w-full" aria-hidden="true" data-sidebar-icon="getting-started">
		<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
	</svg>
}

// sidebarChartModesIcon distinguishes the two chart delivery models.
templ sidebarChartModesIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-full w-full" aria-hidden="true" data-sidebar-icon="chart-modes">
		<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 5.25h6v6h-6v-6Zm9 7.5h6v6h-6v-6ZM10.5 8.25h3m-1.5 0v7.5m-1.5 0h3"></path>
	</svg>
}

// sidebarChartControlsIcon represents the shared chart controls.
templ sidebarChartControlsIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-full w-full" aria-hidden="true" data-sidebar-icon="chart-controls">
		<path stroke-linecap="round" stroke-linejoin="round" d="M4 7h10m4 0h2M4 12h2m4 0h10M4 17h7m4 0h5M14 5v4M6 10v4m5 1v4"></path>
	</svg>
}

// sidebarThemePlaygroundIcon represents appearance changes across chart shapes.
templ sidebarThemePlaygroundIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-full w-full" aria-hidden="true" data-sidebar-icon="theme-playground">
		<path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 3 3 0 003 3h1.504a3 3 0 002.977-2.63c.147-1.106.913-1.92 1.993-2.103m5.496-2.016a2.25 2.25 0 00-2.25-2.25h-1.372c-.516 0-.957-.351-1.108-.845a6.75 6.75 0 10-5.06 8.93"></path>
		<path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.75h.008v.008h-.008V6.75Zm-3.75-1.5h.008v.008H10.5V5.25Zm-3 3h.008v.008H7.5V8.25Zm-.75 3.75h.008v.008H6.75V12Z"></path>
	</svg>
}

// sidebarAttributionsIcon mirrors Goshtoso's native attributions icon.
templ sidebarAttributionsIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-full w-full" aria-hidden="true" data-sidebar-icon="attributions">
		<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path>
	</svg>
}
