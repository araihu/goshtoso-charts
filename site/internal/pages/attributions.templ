package pages

templ AttributionsPage(fragment bool) {
	@layout("Attributions", "attributions", attributionsContent(), fragment)
}

templ attributionsContent() {
	<section class="max-w-3xl space-y-3">
		<p class="text-sm font-semibold text-primary dark:text-primary-dark">Project</p>
		<h1 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Attributions</h1>
		<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Goshtoso Charts builds on these direct rendering, component, and documentation libraries. Versions match the modules and pinned browser assets used by this site.</p>
	</section>
	<section class="grid gap-4 lg:grid-cols-2" aria-label="Backing libraries">
		@attributionCard("Goshtoso", "UI components, theme tokens, and shared browser assets used by the chart documentation site.", "v0.0.13", "MIT", "https://github.com/araihu/goshtoso", "https://github.com/araihu/goshtoso/blob/v0.0.13/LICENSE")
		@attributionCard("Goshtoso App Shells", "Documentation shell, navigation, page structure, and responsive layout.", "commit 4c4aa5ae787e", "MIT", "https://github.com/araihu/goshtoso-app-shells", "https://github.com/araihu/goshtoso-app-shells/blob/4c4aa5ae787e/LICENSE")
		@attributionCard("templ", "Type-safe Go templates used by chart components and documentation pages.", "v0.3.1020", "MIT", "https://github.com/a-h/templ", "https://github.com/a-h/templ/blob/v0.3.1020/LICENSE")
		@attributionCard("go-analyze/charts", "Go-native SVG renderer backing the static vector line, bar, and pie components.", "v0.6.0", "MIT", "https://github.com/go-analyze/charts", "https://github.com/go-analyze/charts/blob/v0.6.0/LICENSE")
		@attributionCard("go-echarts", "Private Go adapter used by the renderer-neutral interactive components.", "v2.7.2", "MIT", "https://github.com/go-echarts/go-echarts", "https://github.com/go-echarts/go-echarts/blob/v2.7.2/LICENSE")
		@attributionCard("Apache ECharts", "Pinned local browser runtime used to render interactive charts; this site does not opt into CDN delivery.", "5.4.3", "Apache-2.0", "https://echarts.apache.org/", "https://github.com/apache/echarts/blob/5.4.3/LICENSE")
	</section>
	<section class="max-w-3xl rounded-radius border border-outline bg-surface-alt p-4 text-sm text-on-surface-muted dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark-muted">
		<h2 class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Local runtime notice</h2>
		<p class="mt-2">The private interactive runtime is pinned in this repository. Its checksum and redistribution notes live in <code>assets/NOTICE.md</code>.</p>
	</section>
}

templ attributionCard(name string, role string, version string, license string, projectURL string, licenseURL string) {
	<article class="rounded-radius border border-outline bg-surface p-5 dark:border-outline-dark dark:bg-surface-dark">
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<h2 class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">
				<a class="underline decoration-outline underline-offset-4 hover:text-primary dark:decoration-outline-dark dark:hover:text-primary-dark" href={ templ.URL(projectURL) }>{ name }</a>
			</h2>
			<span class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ version }</span>
		</div>
		<p class="mt-2 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ role }</p>
		<p class="mt-3 text-sm"><a class="font-semibold text-primary underline dark:text-primary-dark" href={ templ.URL(licenseURL) }>{ license } license</a></p>
	</article>
}
